# Copy this file to ".env" for local use. On Render, add these as Environment Variables instead.

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Any long random text (30+ characters). Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-text-123456789

# Free AI: get a key at https://aistudio.google.com/apikey
# AI_MODE=gemini uses the real AI. AI_MODE=mock gives demo questions without any key.
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# The first administrator account (created automatically on start). Change the password!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# Only needed if the frontend is hosted separately (e.g. Netlify). Comma separated, no trailing slash.
FRONTEND_ORIGIN=
PORT=3000
